<!-- BEGIN: InteractiveComposerScript -->
<script data-purpose="composer-interaction">
    document.addEventListener('DOMContentLoaded', () => {
      const statusInput = document.getElementById('wallStatusInput');
      const shareBtn = document.getElementById('shareBtn');
      const charCount = document.getElementById('charCount');
      const feedStream = document.getElementById('wallFeedStream');

      // Update character counter and button state on input
      statusInput.addEventListener('input', () => {
        const length = statusInput.value.length;
        charCount.textContent = `${length}/280`;
        
        if (length > 0) {
          shareBtn.removeAttribute('disabled');
        } else {
          shareBtn.setAttribute('disabled', 'true');
        }
      });

      // Handle Share action
      shareBtn.addEventListener('click', () => {
        const text = statusInput.value.trim();
        if (!text) return;

        // Create new authentic 2008 Wall Post DOM element
        const newPost = document.createElement('article');
        newPost.className = 'border-t border-[#e9e9e9] pt-3 flex space-x-2.5 animate-pulse';
        newPost.setAttribute('data-purpose', 'feed-item');

        newPost.innerHTML = `
          <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuAApRj_NJ7teK7Rf3hfD4PZF-PaAcqzUl2XHj6wiBEFBq9CDMsnwVNBEh0FydhuKO-XYSEZHJ--QtxLpSs4hL2Kh2Z1r9G5_-kzaSjpGIIFtC18Z3BSjqjGy5vE7VdKFQcIt0NPvXNobYQMwcnF5O_oxbpZ7O0bg8AJBcPbyKPsLdJns02mf5GD-tWBxhY590G8CWjTeRynMuTaaOIcWYgNxLzHbOx6lLCdN0xe6CtN-0--Ck6uwO8" alt="Jon Doe" class="w-10 h-10 object-cover border border-[#cccccc] flex-shrink-0" />
          <div class="flex-1 text-xs">
            <div>
              <a href="#" class="font-bold text-fb-navy hover:underline">Jon Doe</a>
              <span class="text-gray-900 ml-1">${escapeHtml(text)}</span>
            </div>
            <div class="text-[10px] text-gray-400 mt-1">
              <span>Just now</span> · 
              <a href="#" class="text-fb-navy hover:underline">Comment</a> · 
              <a href="#" class="text-fb-navy hover:underline">Like</a>
            </div>
          </div>
        `;

        // Prepend post to feed
        feedStream.insertBefore(newPost, feedStream.firstChild);

        // Reset input and button
        statusInput.value = '';
        charCount.textContent = '0/280';
        shareBtn.setAttribute('disabled', 'true');

        setTimeout(() => {
          newPost.classList.remove('animate-pulse');
        }, 600);
      });

      // Sanitization helper
      function escapeHtml(str) {
        return str
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }
    });
  </script>
<!-- END: InteractiveComposerScript -->
